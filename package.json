{
  "name": "dexfoundry",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Autonomous B2B service operations engine.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "db:migrate": "node dist/src/cli/migrate.js",
    "db:smoke": "node dist/src/cli/db-smoke.js",
    "dispatch:once": "node dist/src/cli/dispatch.js",
    "results:serve": "node dist/src/cli/workflow-result-server.js",
    "n8n:proof:seed": "node dist/src/cli/n8n-proof-seed.js",
    "n8n:proof:replay": "node dist/src/cli/n8n-proof-replay.js",
    "n8n:proof:assert": "node dist/src/cli/n8n-proof-assert.js",
    "a11y:manual-proof": "node dist/src/cli/accessibility-manual-proof.js",
    "a11y:simulate-service": "node dist/src/cli/accessibility-service-simulate.js",
    "outbound:check": "node dist/src/cli/outbound-check.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "pa11y": "10.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
